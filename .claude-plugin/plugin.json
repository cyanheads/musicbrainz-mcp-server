{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "musicbrainz-mcp-server",
  "version": "0.2.0",
  "description": "Search artists, releases, recordings, works, and labels; traverse relationships; resolve ISRC/ISWC/barcode; fetch cover art via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "Casey Hand",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "homepage": "https://github.com/cyanheads/musicbrainz-mcp-server#readme",
  "repository": "https://github.com/cyanheads/musicbrainz-mcp-server",
  "license": "Apache-2.0",
  "keywords": [
    "musicbrainz",
    "cover-art-archive",
    "music-metadata",
    "discography",
    "mbid",
    "isrc",
    "iswc",
    "music",
    "mcp",
    "mcp-server",
    "model-context-protocol"
  ],
  "userConfig": {
    "clamp_oversized_limits": {
      "type": "boolean",
      "title": "Clamp Oversized Limits",
      "description": "Clamp search/browse page limits above 100 with a notice. Disable to enforce maximum 100.",
      "default": true
    }
  },
  "mcpServers": {
    "musicbrainz-mcp-server": {
      "command": "npx",
      "args": ["-y", "@cyanheads/musicbrainz-mcp-server"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MUSICBRAINZ_CONTACT": "${MUSICBRAINZ_CONTACT}",
        "MUSICBRAINZ_CLAMP_OVERSIZED_LIMITS": "${user_config.clamp_oversized_limits}"
      }
    }
  }
}
